# Copy to .env and fill in.

# Required: the agent's brain.
ANTHROPIC_API_KEY=sk-ant-...

# Model to drive the agent. Opus 5 is the strongest for multi-step tool use.
DEAL_HUNTER_MODEL=claude-opus-5

# Scraping knobs
DEAL_HUNTER_TIMEOUT=20            # per-request seconds
DEAL_HUNTER_MAX_RESULTS=5         # max products parsed per platform

# When live scraping is blocked (CAPTCHA / 503), fall back to bundled sample
# data so the full pipeline still runs end-to-end. Set to "0" to force live only.
DEAL_HUNTER_ALLOW_MOCK=1
